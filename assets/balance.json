// Silver & Ash - balancing values.
// Change a number, save, and start the game again (in the test build: F5 reloads at once).
// Times in seconds (s), distances in metres (m), speeds in metres per second (m/s).
// A missing value uses its standard; a wrong one (negative, a typo in the name ...) too - see the log.
// Explained in docs/balancing.md.
{
  // Seconds between dying and the level starting again.
  "restartDelay": 2,

  "player": {
    "maxHealth": 100,
    "maxSpeed": 6,                      // m/s walking
    "accelerationTime": 0.1,            // s from standing to full speed
    "airControl": 0.7,                  // 0 = no steering in the air, 1 = full
    "airSpeedMultiplier": 1.15,         // top speed in the air, times maxSpeed
    "jumpHeight": 1.3,                  // m (at most 1.7: rooms are 3.5 m, the player 1.8 m)
    "jumpDuration": 0.8,                // s from take-off to landing - gravity follows from height and duration
    "landingDipPerSpeed": 0.01875,      // m the eyes sink per m/s of falling speed
    "landingDipMax": 0.22,              // m, never deeper
    "landingDipDuration": 0.3,          // s for the whole nod
    "landingTiltPerMetre": 0.35,        // how much the view tilts down with the dip
    "perfectJumpWindow": 0.12,          // s before or after landing
    "perfectJumpSpeedBonus": 0.2,       // +20 % top speed
    "perfectJumpDipFactor": 0.4,        // the landing nod is only 40 % as deep
    "staminaJumps": 5,                  // segments of the stamina bar
    "staminaRechargeTime": 3,           // s from empty to full (only on the ground)
    "exhaustedJumpSpeedPenalty": 0.2,   // -20 % speed after a jump with an empty bar
    "dashDistance": 4,                  // m
    "dashDuration": 0.15,               // s
    "dodgeDuration": 0.4,               // s
    "dodgeSpeed": 10,                   // m/s
    "dodgeStaminaSegments": 2,
    "crouchTransitionTime": 0.1         // s to duck or stand up
  },

  "blade": {
    "cooldown": 0.4,                    // s between swings
    "damage": 40,
    "chargeTime": 1,                    // s of holding until fully charged
    "chargeMaxMultiplier": 2,           // fully charged: 200 % damage
    "chargeStaminaSegments": 1,         // a full charge costs this much stamina
    "range": 2.5,                       // m from the eyes (provisional, #425)
    "angle": 90,                        // degrees, full width of the cone (at most 180)
    "coneStartBehind": 0.6,             // m the cone's tip lies behind the eyes (wider close up)
    "knockback": 0,                     // m the blade pushes enemies away (0 = not at all) ...
    "chargedKnockback": 0,              // ... and fully charged ...
    "knockbackTime": 0.25               // ... the push taking this long (s)
  },

  "club": {                             // the club (Worn): slower and harder than the blade, knocks ghouls and bats back (not Gorm)
    "cooldown": 0.55,
    "damage": 50,
    "chargeTime": 1,
    "chargeMaxMultiplier": 2,
    "chargeStaminaSegments": 1,
    "range": 2,
    "angle": 90,
    "coneStartBehind": 0.6,
    "knockback": 3,                     // m an enemy flies back ...
    "chargedKnockback": 6,              // ... and when fully charged
    "knockbackTime": 0.25               // s the push takes
  },

  "pistol": {
    "damage": 35,
    "headshotMultiplier": 3,            // 300 % on the head
    "range": 50,                        // m
    "cooldown": 0.7,                    // s between shots
    "magazineSize": 7,                  // rounds, then reload (R) ...
    "reloadTime": 1.5,                  // ... taking this long (s); the supply is unlimited
    "pierce": 0,                        // enemies a shot goes on through after the first (walls stop it)
    "pellets": 1,                       // bullets per shot ...
    "spread": 0                         // ... in a cone this wide (degrees)
  },

  "rifle": {                            // the rifle (Forged): heavy aimed shots
    "damage": 80,
    "headshotMultiplier": 3,            // 300 % on the head
    "range": 80,                        // m
    "cooldown": 1.4,                    // s between shots
    "magazineSize": 4,
    "reloadTime": 2.5,
    "pierce": 1,                        // goes through one enemy into the next
    "pellets": 1,
    "spread": 0
  },

  "blunderbuss": {                      // the blunderbuss (Forged): a cone of pellets, only up close
    "damage": 12,                       // per pellet
    "headshotMultiplier": 1,
    "range": 12,                        // m: beyond this the pellets do nothing
    "cooldown": 0.5,
    "magazineSize": 1,
    "reloadTime": 1.8,
    "pierce": 0,
    "pellets": 9,
    "spread": 20                        // degrees, full width of the cone
  },

  "dummy": {
    "maxHealth": 100,
    "downTime": 3                       // s lying on the ground
  },

  "ghoul": {
    "maxHealth": 100,
    "corpseTime": 2,                    // s the body lies there
    "sightRange": 12,                   // m
    "speed": 5,                         // m/s crawling
    "attackReach": 1.6,                 // m: starts its blow this close
    "hitReach": 2.4,                    // m: the blow still hits this far
    "windUpTime": 0.5,                  // s of warning before the blow
    "attackHalfAngle": 60,              // degrees to the side it still hits
    "attackDamage": 30,
    "recoverTime": 0.6,                 // s of rest after a blow
    "repathTime": 0.5                   // s between path searches
  },

  // Gorm, the Chained - the troll, boss of level 0 (decision record 0007).
  "gorm": {
    "maxHealth": 3600,
    "speed": 2.5,                       // m/s walking, slower than the player
    "stopDistance": 3,                  // m: he stops walking this close
    "headMultiplier": 1.5,              // a pistol shot at his head: 150 %
    "repathTime": 0.5,                  // s between path searches
    "silverMin": 100,                   // silver he leaves behind ...
    "silverMax": 150,
    "equipmentVampiricChance": 0.2,     // he always leaves a piece of equipment: Vampiric in 20 % of cases, else Royal ...
    "extraSilver": 100,                 // ... or this much silver if the loot pool has nothing of that tier or above
    "stairsRiseTime": 3,                // s the spiral staircase takes to rise after his death
    "nearRange": 8,                     // m: this close he uses hammer or chain swing (50/50) ...
    "farRange": 30,                     // ... up to this far he throws his chain. Never the same attack twice in a row
    "pauseTime": 1.2,                   // s of rest after every attack - strike back!
    "hammerWindUp": 0.8,                // s: club raised, red circle on the floor -> JUMP
    "hammerDamage": 40,
    "shockwaveSpeed": 8,                // m/s along the floor ...
    "shockwaveRadius": 12,              // ... up to this far ...
    "shockwaveHeight": 0.4,             // ... this high: higher in the air is safe
    "stuckTime": 2,                     // s the club sticks after a blow that hit nobody ...
    "stuckDamageMultiplier": 2,         // ... meanwhile he takes double damage
    "swingWindUp": 0.6,                 // s: the chain is spun up -> DODGE (ducked)
    "swingDamage": 30,
    "swingReach": 12,                   // m: one step back is not enough - dodge (provisional, #430)
    "swingLow": 1.1,                    // m above his feet the chain passes from here ...
    "swingHigh": 1.6,                   // ... to here: standing or jumping it hits, ducked in a dodge not
    "swingTime": 0.6,                   // s the chain takes to sweep from his left over the front to his right ...
    "swingArc": 180,                    // ... along this arc (degrees): behind him you are safe
    "throwWindUp": 0.5,                 // s: the hook glows red -> step ASIDE or behind a pillar
    "hookSpeed": 18,                    // m/s, straight to the point he aimed at
    "hookLead": 1,                      // aims where you will be if you keep your pace (0 = where you stand) ... (provisional, #437)
    "hookLeadMax": 6,                   // ... but at most this far (m) ahead
    "hookLockTime": 0.2,                // s before the throw his aim locks: he stands rigid - stop or dodge NOW
    "chaseThrowTime": 8,                // s chasing you without an attack, then he stops and throws anyway (0 = never) ...
    "chaseWarnTime": 2,                 // ... the last s of it his hook swings at his side
    "throwDamage": 20,
    "pullDistance": 3,                  // m: a hit pulls you this close ...
    "pullTime": 0.4,                    // ... within this time, without control
    "phase2Health": 0.5,                // at 50 % health he roars once: phase 2 ...
    "roarTime": 1.5,                    // ... s of roaring (no attack meanwhile) ...
    "phase2SpeedUp": 1.4,               // ... then walking, warnings and pauses 40 % faster
    "stoneCount": 6,                    // phase 2: every hammer blow shakes this many stones from the ceiling ...
    "stoneSpread": 4,                   // ... landing up to this far (m) from you ...
    "stoneWarning": 1,                  // ... their shadow shows this long (s) before they land ...
    "stoneRadius": 1,                   // ... hitting within this radius (m) ...
    "stoneDamage": 25                   // ... with this damage
  },

  "bat": {
    "maxHealth": 40,
    "corpseTime": 2.5,                  // s the body lies there
    "sightRange": 15,                   // m
    "circleRadiusMin": 4,               // m, each bat gets its own distance ...
    "circleRadiusMax": 6,               // ... between these two
    "turnRoundMin": 2,                  // s, turns round after a random time ...
    "turnRoundMax": 4,                  // ... between these two
    "circleSpeed": 3,                   // m/s along the circle
    "flySpeed": 6,                      // m/s at most
    "climbSpeed": 3,                    // m/s up and down
    "circleHeightMin": 2,               // m above the floor ...
    "circleHeightMax": 2.8,             // ... rising and sinking between these two
    "bobTime": 2,                       // s for one rise and sink
    "spitInterval": 1.6,                // s between spits
    "spitWindUpTime": 0.4,              // s of glowing before a spit
    "spitAimBelowEyes": 0.2,            // m - a dodging (ducked) player is under the bolt
    "diveInterval": 6,                  // s between dives
    "screechTime": 0.5,                 // s of screeching before a dive
    "diveSpeed": 10,                    // m/s
    "biteDamage": 20,
    "repathTime": 0.5                   // s between path searches
  },

  "experience": {
    "ghoul": 30,                        // experience for killing a ghoul (the killing hit counts)
    "bat": 20,                          // for a bat
    "firstLevel": 100,                  // needed from level 0 to 1 ...
    "growth": 1.25                      // ... and every further level x1.25 (100, 125, 156, 195, 244 ...)
  },

  // After a level up: some boons drawn from the pool, each counted from the base value (3 x 5 % = 15 %).
  "boons": {
    "offered": 3,                       // how many different boons a level up offers
    "staminaRegen": 0.05,               // stamina refills 5 % faster
    "health": 5,                        // +5 maximum health, healed at once
    "healthCap": 235,                   // no more health boons offered once one would go beyond this (life bar: 1 px per point)
    "damage": 0.05,                     // +5 % damage with every weapon
    "experience": 0.025                 // +2.5 % experience per kill
  },

  "drops": {
    "ghoulChance": 0.12,                // a killed ghoul drops something in 12 % of cases (0 = never, 1 = always)
    "batChance": 0.08,                  // a killed bat in 8 %
    "consecratedAmmoShare": 0.3         // of all drops, 30 % are consecrated ammunition, the rest blood vials
  },

  // Silver, the currency of a run (spent at the merchant from v0.11). A kill drops silver with its chance, between min and max (both included).
  "silver": {
    "ghoulChance": 0.5,                 // a killed ghoul drops silver in 50 % of cases (0 = never, 1 = always)
    "batChance": 0.5,                   // a killed bat as well
    "ghoulMin": 1,                      // a killed ghoul drops 1 to 3 silver ...
    "ghoulMax": 3,
    "batMin": 1,                        // ... a killed bat as well (0 and 0 = none)
    "batMax": 3
  },

  // Keys open locked doors (each fits every lock and is used up). Lost with the run.
  "keys": {
    "roomChance": 0.1,                  // a cleared combat room leaves a key in its middle in 10 % of cases
    "enemyChance": 0.025                // a killed enemy drops one in 2.5 %
  },

  // Teleporters at special places of a level (start room, in front of the boss door). Stepping onto one unlocks it for all players.
  "teleporters": {
    "radius": 0.8,                      // metres from its middle within which the feet stand on it (to unlock it and to travel from it)
    "height": 1.5                       // metres above its floor up to which the feet still stand on it (a jump stays on it, a ledge above does not)
  },

  // Chests (decision record 0006). About every fourth combat room gets one; it rises from the floor once the room is cleared.
  // Per tier: its share among combat-room chests (near the start / farthest away, rising in between), in a treasure room,
  // in a locked treasure room and in a secret room (the shares of all tiers count in proportion), how often it is locked, the silver
  // inside (min to max), the chance of a blood vial and the chance of a piece of equipment from the loot pool (at least of the
  // chest's tier; if the pool has nothing of that tier or above: the chest's silver once more).
  "chests": {
    "combatRoomChance": 0.25,
    "treasureChestsMin": 1,             // a treasure room holds 1 to 2 chests
    "treasureChestsMax": 2,
    "beggar":  { "combatShareNear": 0.7,  "combatShareFar": 0.55, "treasureShare": 0.2, "lockedTreasureShare": 0.15, "secretShare": 0, "lockedChance": 0.1,  "silverMin": 10, "silverMax": 20,  "bloodVialChance": 0.1, "equipmentChance": 0.3 },
    "guard":   { "combatShareNear": 0.27, "combatShareFar": 0.37, "treasureShare": 0.45, "lockedTreasureShare": 0.3, "secretShare": 0.35, "lockedChance": 0.35, "silverMin": 20, "silverMax": 35,  "bloodVialChance": 0.25, "equipmentChance": 0.5 },
    "king":    { "combatShareNear": 0.03, "combatShareFar": 0.08, "treasureShare": 0.3, "lockedTreasureShare": 0.45, "secretShare": 0.5, "lockedChance": 0.7,  "silverMin": 40, "silverMax": 60,  "bloodVialChance": 0.5, "equipmentChance": 0.8 },
    "vampire": { "combatShareNear": 0,    "combatShareFar": 0,    "treasureShare": 0.05, "lockedTreasureShare": 0.1, "secretShare": 0.15, "lockedChance": 1,    "silverMin": 80, "silverMax": 120, "bloodVialChance": 1, "equipmentChance": 1 }
  },

  // Equipment as loot (decision records 0006 and 0008): every weapon and item lies once in the loot pool of a run, a draw takes it out.
  // A draw gives at least the tier asked for (a chest's own tier); used up tiers go to the next higher one.
  "loot": {
    "higherTierChance": 0.1,            // a draw rises one tier in 10 % of cases (0 = never, 1 = always)
    "itemShare": 0.7                    // 70 % of the draws are items, 30 % weapons (if that kind is used up in the tier: the other)
  },

  "doors": {
    "normalOpenTime": 0.9,              // seconds a wooden double door takes to swing fully open (only the picture: the way is free at once)
    "lockedOpenTime": 1.3,              // the same for a locked door (one heavy leaf)
    "bossOpenTime": 2.2,                // the same for a boss door (two heavy iron leaves): 132 ticks, evenly (#566)
    "bossCloseTicks": 100,              // ticks the boss door takes to slam shut when its boss room seals (#566)
    "bossShutTick": 78                  // the hard stop of that slam: the door blocks from this tick on (#566)
  },

  // Portcullises (#540, #558) at the doors of arenas, in ticks (60 a second).
  "grates": {
    "fallTicks": 63,                    // falling shut: two jerks, then the drop; shut from 3/4 of the time (tick 47)
    "liftTicks": 126,                   // rising fully open, evenly
    "blockHeight": 1.85                 // metres: a rising grate blocks until its spike tips are above this (a falling one at once)
  },

  // The Well of Sirius (#438). Price per throw, chances and the most throws are still open: using it only spends it.
  "well": {
    "levelChance": 1,                   // chance that a level has a well (at most one); provisional: every level
    "collisionRadius": 0.95             // m: the circle nobody walks through
  },

  // Free-standing columns (#539): the gap to a wall, door or other column is 0 (never: nothing leans on a column) or
  // at least the widest figure's diameter plus this play. Provisional.
  "columns": {
    "play": 0.2                         // m on top of the widest figure's diameter
  },

  // Directional sound (issue #491): what a player hears of a sound with a place (an enemy, a door, a chest, another
  // player's steps). Provisional until the listening test.
  "hearing": {
    "nearDistance": 2,                  // m from the ears: up to here full volume ...
    "range": 30,                        // m: ... from there fading, silent here (not below nearDistance)
    "rolloff": 1.5,                     // bend of the fade: 1 = straight, above 1 = falls fast at first, quiet tail
    "maxPan": 0.8                       // how far a sound right beside the ears goes to that side (1 = only that ear)
  },

  "bloodVial": {
    "heal": 30                          // health it gives back (never above the maximum)
  },

  "consecratedAmmo": {
    "fireRateMultiplier": 2,            // the pistol fires twice as fast (damage stays) ...
    "duration": 10                      // ... for 10 s, starting at once when picked up
  },

  "layout": {
    "combatRoomsMin": 12,               // a level has 12 to 14 combat rooms (aim: about 20 minutes, see docs/balancing.md)
    "combatRoomsMax": 14,
    "corridorChance": 0.6,              // 60 % of rooms are reached through a corridor, the rest through a shared wall
    "maxLoops": 2,                      // at most 2 extra connections that make a second way round
    "treasureRooms": 1,                 // treasure rooms per level with an ordinary door ...
    "lockedTreasureRooms": 1,           // ... and behind a locked door (needs a key)
    "secretRooms": 1                    // secret rooms per level, behind a cracked wall of a combat room
  },

  // Spawn budget: each combat room buys enemies with its budget (near the start -> farthest, evenly in between; the boss
  // room has its own). Each kind costs points; weights (near -> far) decide which kind comes next. Enemies stand on
  // random free floor, keeping away from the doors and from each other. Every combat room gets at least one enemy.
  "difficulty": {
    "budgetNear": 10,                   // budget of the combat room nearest to the start ...
    "budgetFar": 24,                    // ... and of the farthest one
    "budgetBoss": 0,                    // the boss room besides Gorm (0 = Gorm fights alone)
    "ghoulCost": 2,
    "batCost": 3,
    "ghoulWeightNear": 0.85,            // near the start mostly ghouls ...
    "ghoulWeightFar": 0.6,
    "batWeightNear": 0.15,              // ... far away more bats
    "batWeightFar": 0.4,
    "maxBatsPerRoom": 3,                // never more bats than this in one room (provisional, issue #391)
    "doorDistance": 4,                  // m: no enemy closer than this to a door of its room (also where it comes out)
    "doorConeAngle": 30,                // degrees, half: straight into the room through a door; inside doorDistance is enough (#490)
    "sideDoorDistance": 10,             // m: outside that cone - beside the door frame, unseen on entering - enemies keep this far (#490)
    "playerDistance": 3,                // m: no enemy comes out closer than this to any player (provisional, #445)
    "spacing": 2.5,                     // m: no two enemies closer than this
    "emergeTime": 0.8                   // s: a combat room's enemies come out of floor/ceiling when it seals (#424)
  },

  "bloodBolt": {
    "speed": 12,                        // m/s
    "damage": 20,
    "radius": 0.15,                     // m
    "lifeTime": 5                       // s until it disappears
  }
}
