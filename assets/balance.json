// Silver & Ash - balancing values.
// Change a number, save, and start the game again (in the test build: F5 reloads at once).
// Times in seconds (s), distances in metres (m), speeds in metres per second (m/s).
// A missing value uses its standard; a wrong one (negative, a typo in the name ...) too - see the log.
// Explained in docs/balancing.md.
{
  // Seconds between dying and the level starting again.
  "restartDelay": 2,

  "player": {
    "maxHealth": 100,
    "maxSpeed": 6,                      // m/s walking
    "accelerationTime": 0.1,            // s from standing to full speed
    "airControl": 0.7,                  // 0 = no steering in the air, 1 = full
    "airSpeedMultiplier": 1.15,         // top speed in the air, times maxSpeed
    "jumpHeight": 1.3,                  // m (at most 1.7: rooms are 3.5 m, the player 1.8 m)
    "jumpDuration": 0.8,                // s from take-off to landing - gravity follows from height and duration
    "landingDipPerSpeed": 0.01875,      // m the eyes sink per m/s of falling speed
    "landingDipMax": 0.22,              // m, never deeper
    "landingDipDuration": 0.3,          // s for the whole nod
    "landingTiltPerMetre": 0.35,        // how much the view tilts down with the dip
    "perfectJumpWindow": 0.12,          // s before or after landing
    "perfectJumpSpeedBonus": 0.2,       // +20 % top speed
    "perfectJumpDipFactor": 0.4,        // the landing nod is only 40 % as deep
    "staminaJumps": 5,                  // segments of the stamina bar
    "staminaRechargeTime": 3,           // s from empty to full (only on the ground)
    "exhaustedJumpSpeedPenalty": 0.2,   // -20 % speed after a jump with an empty bar
    "dashDistance": 4,                  // m
    "dashDuration": 0.15,               // s
    "dodgeDuration": 0.4,               // s
    "dodgeSpeed": 10,                   // m/s
    "dodgeStaminaSegments": 2,
    "crouchTransitionTime": 0.1         // s to duck or stand up
  },

  "blade": {
    "cooldown": 0.4,                    // s between swings
    "damage": 40,
    "chargeTime": 1,                    // s of holding until fully charged
    "chargeMaxMultiplier": 2,           // fully charged: 200 % damage
    "chargeStaminaSegments": 1,         // a full charge costs this much stamina
    "range": 2,                         // m from the eyes
    "angle": 90,                        // degrees, full width of the cone (at most 180)
    "coneStartBehind": 0.6              // m the cone's tip lies behind the eyes (wider close up)
  },

  "pistol": {
    "damage": 35,
    "headshotMultiplier": 3,            // 300 % on the head
    "range": 50,                        // m
    "cooldown": 0.8                     // s between shots
  },

  "dummy": {
    "maxHealth": 100,
    "downTime": 3                       // s lying on the ground
  },

  "ghoul": {
    "maxHealth": 100,
    "corpseTime": 2,                    // s the body lies there
    "sightRange": 12,                   // m
    "speed": 4.5,                       // m/s crawling
    "attackReach": 1.6,                 // m: starts its blow this close
    "hitReach": 2.4,                    // m: the blow still hits this far
    "windUpTime": 0.5,                  // s of warning before the blow
    "attackHalfAngle": 60,              // degrees to the side it still hits
    "attackDamage": 25,
    "recoverTime": 0.8,                 // s of rest after a blow
    "repathTime": 0.5                   // s between path searches
  },

  "bat": {
    "maxHealth": 40,
    "corpseTime": 2.5,                  // s the body lies there
    "sightRange": 15,                   // m
    "circleRadiusMin": 4,               // m, each bat gets its own distance ...
    "circleRadiusMax": 6,               // ... between these two
    "turnRoundMin": 2,                  // s, turns round after a random time ...
    "turnRoundMax": 4,                  // ... between these two
    "circleSpeed": 3,                   // m/s along the circle
    "flySpeed": 6,                      // m/s at most
    "climbSpeed": 3,                    // m/s up and down
    "circleHeightMin": 2,               // m above the floor ...
    "circleHeightMax": 2.8,             // ... rising and sinking between these two
    "bobTime": 2,                       // s for one rise and sink
    "spitInterval": 2,                  // s between spits
    "spitWindUpTime": 0.4,              // s of glowing before a spit
    "spitAimBelowEyes": 0.2,            // m - a dodging (ducked) player is under the bolt
    "diveInterval": 6,                  // s between dives
    "screechTime": 0.5,                 // s of screeching before a dive
    "diveSpeed": 10,                    // m/s
    "biteDamage": 15,
    "repathTime": 0.5                   // s between path searches
  },

  "experience": {
    "ghoul": 30,                        // experience for killing a ghoul (the killing hit counts)
    "bat": 20,                          // for a bat
    "firstLevel": 100,                  // needed from level 1 to 2 ...
    "growth": 1.25                      // ... and every further level x1.25 (100, 125, 156, 195, 244 ...)
  },

  // After a level up: some boons drawn from the pool, each counted from the base value (3 x 5 % = 15 %).
  "boons": {
    "offered": 3,                       // how many different boons a level up offers
    "staminaRegen": 0.05,               // stamina refills 5 % faster
    "health": 5,                        // +5 maximum health, healed at once
    "damage": 0.05,                     // +5 % damage with every weapon
    "experience": 0.025                 // +2.5 % experience per kill
  },

  "drops": {
    "ghoulChance": 0.12,                // a killed ghoul drops something in 12 % of cases (0 = never, 1 = always)
    "batChance": 0.08,                  // a killed bat in 8 %
    "consecratedAmmoShare": 0.3         // of all drops, 30 % are consecrated ammunition, the rest blood vials
  },

  // Silver, the currency of a run (spent at the merchant from v0.11). A kill drops silver with its chance, between min and max (both included).
  "silver": {
    "ghoulChance": 0.5,                 // a killed ghoul drops silver in 50 % of cases (0 = never, 1 = always)
    "batChance": 0.5,                   // a killed bat as well
    "ghoulMin": 1,                      // a killed ghoul drops 1 to 3 silver ...
    "ghoulMax": 3,
    "batMin": 1,                        // ... a killed bat as well (0 and 0 = none)
    "batMax": 3
  },

  // Keys open locked doors (each fits every lock and is used up). Lost with the run.
  "keys": {
    "roomChance": 0.1,                  // a cleared combat room leaves a key in its middle in 10 % of cases
    "enemyChance": 0.025                // a killed enemy drops one in 2.5 %
  },

  // Chests (decision record 0006). About every fourth combat room gets one; it rises from the floor once the room is cleared.
  // Per tier: its share among combat-room chests (near the start / farthest away, rising in between), in a treasure room,
  // in a locked treasure room and in a secret room (the shares of all tiers count in proportion), how often it is locked, the silver
  // inside (min to max) and the chance of a blood vial.
  "chests": {
    "combatRoomChance": 0.25,
    "treasureChestsMin": 1,             // a treasure room holds 1 to 2 chests
    "treasureChestsMax": 2,
    "beggar":  { "combatShareNear": 0.7,  "combatShareFar": 0.55, "treasureShare": 0.2, "lockedTreasureShare": 0.15, "secretShare": 0, "lockedChance": 0.1,  "silverMin": 10, "silverMax": 20,  "bloodVialChance": 0.1 },
    "guard":   { "combatShareNear": 0.27, "combatShareFar": 0.37, "treasureShare": 0.45, "lockedTreasureShare": 0.3, "secretShare": 0.35, "lockedChance": 0.35, "silverMin": 20, "silverMax": 35,  "bloodVialChance": 0.25 },
    "king":    { "combatShareNear": 0.03, "combatShareFar": 0.08, "treasureShare": 0.3, "lockedTreasureShare": 0.45, "secretShare": 0.5, "lockedChance": 0.7,  "silverMin": 40, "silverMax": 60,  "bloodVialChance": 0.5 },
    "vampire": { "combatShareNear": 0,    "combatShareFar": 0,    "treasureShare": 0.05, "lockedTreasureShare": 0.1, "secretShare": 0.15, "lockedChance": 1,    "silverMin": 80, "silverMax": 120, "bloodVialChance": 1 }
  },

  "bloodVial": {
    "heal": 30                          // health it gives back (never above the maximum)
  },

  "consecratedAmmo": {
    "fireRateMultiplier": 2,            // the pistol fires twice as fast (damage stays) ...
    "duration": 10                      // ... for 10 s, starting at once when picked up
  },

  "layout": {
    "combatRoomsMin": 12,               // a level has 12 to 14 combat rooms (aim: about 20 minutes, see docs/balancing.md)
    "combatRoomsMax": 14,
    "corridorChance": 0.6,              // 60 % of rooms are reached through a corridor, the rest through a shared wall
    "maxLoops": 2,                      // at most 2 extra connections that make a second way round
    "treasureRooms": 1,                 // treasure rooms per level with an ordinary door ...
    "lockedTreasureRooms": 1,           // ... and behind a locked door (needs a key)
    "secretRooms": 1                    // secret rooms per level, behind a cracked wall of a combat room
  },

  "difficulty": {
    "ghoulShareNear": 0.7,              // the combat room nearest to the start fills 70 % of its ghoul places ...
    "ghoulShareFar": 1,                 // ... the farthest one (and the boss room) all of them; in between it rises evenly
    "batShareNear": 0.25,               // bats: a quarter of the places near the start ...
    "batShareFar": 1                    // ... all places far away. Every combat room gets at least one enemy
  },

  "bloodBolt": {
    "speed": 12,                        // m/s
    "damage": 15,
    "radius": 0.15,                     // m
    "lifeTime": 5                       // s until it disappears
  }
}
