<Project Sdk="Microsoft.NET.Sdk">

  <!-- Window, input and rendering. Contains no game rules - those live in SilverAndAsh.Core. -->

  <PropertyGroup>
    <!-- WinExe: a pure window application - no black console window behind the game.
         Diagnostic output goes to the log file instead (%LOCALAPPDATA%\SilverAndAsh\logs). -->
    <OutputType>WinExe</OutputType>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\SilverAndAsh.Core\SilverAndAsh.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Raylib-cs" Version="8.1.0" />
  </ItemGroup>

  <!-- Game data (levels, later models and more) is copied next to the .exe, keeping its folder structure. -->
  <ItemGroup>
    <None Include="..\..\assets\**\*"
          Link="assets\%(RecursiveDir)%(Filename)%(Extension)"
          CopyToOutputDirectory="PreserveNewest"
          CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
